const registrationForm = document.getElementById('registrationForm');
const loginForm = document.getElementById('adminLoginForm');
const adminLoginSection = document.getElementById('adminLoginSection');
const adminDashboard = document.getElementById('adminDashboard');
const registrationsTableBody = document.getElementById('registrationsTableBody');
const loginMessage = document.getElementById('loginMessage');
const refreshBtn = document.getElementById('refreshBtn');
const logoutBtn = document.getElementById('logoutBtn');

function setMessage(element, message, type = '') {
  if (!element) return;
  element.textContent = message;
  element.className = `form-message ${type}`.trim();
}

if (registrationForm) {
  registrationForm.addEventListener('submit', async (event) => {
    event.preventDefault();

    const formData = new FormData(registrationForm);
    const payload = Object.fromEntries(formData.entries());

    const response = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await response.json();
    const message = document.getElementById('formMessage');

    if (result.success) {
      setMessage(message, 'Registration submitted successfully. Our team will review it soon.', 'success');
      registrationForm.reset();
    } else {
      setMessage(message, result.message || 'Something went wrong.', 'error');
    }
  });
}

async function fetchRegistrations() {
  const response = await fetch('/api/admin/registrations', {
    method: 'GET',
    headers: { 'Content-Type': 'application/json' }
  });

  if (response.status === 401) {
    window.location.href = '/admin.html';
    return [];
  }

  const result = await response.json();
  return result.registrations || [];
}

function renderStats(registrations) {
  const total = document.getElementById('totalCount');
  const pending = document.getElementById('pendingCount');
  const approved = document.getElementById('approvedCount');

  if (total) total.textContent = registrations.length;
  if (pending) pending.textContent = registrations.filter((entry) => entry.status === 'Pending').length;
  if (approved) approved.textContent = registrations.filter((entry) => entry.status === 'Approved').length;
}

function renderTable(registrations) {
  if (!registrationsTableBody) return;

  if (!registrations.length) {
    registrationsTableBody.innerHTML = '<tr><td colspan="7">No registrations yet.</td></tr>';
    renderStats([]);
    return;
  }

  registrationsTableBody.innerHTML = registrations.map((entry) => `
    <tr>
      <td>
        <strong>${entry.child_name}</strong><br />
        <small>Age ${entry.age}</small>
      </td>
      <td>
        ${entry.guardian_name}<br />
        <small>${entry.email}</small>
      </td>
      <td>${entry.program}</td>
      <td>${entry.session}</td>
      <td><span class="badge ${entry.status.toLowerCase()}">${entry.status}</span></td>
      <td>
        <span class="badge ${entry.payment_status === 'Paid' ? 'approved' : 'pending'}">${entry.payment_status || 'Unpaid'}</span>
      </td>
      <td>
        <div class="action-group">
          <button class="action-btn pay" data-action="approve" data-id="${entry.id}">Approve</button>
          <button class="action-btn pay" data-action="pay" data-id="${entry.id}">Pay Now</button>
          <button class="action-btn delete" data-action="delete" data-id="${entry.id}">Delete</button>
        </div>
      </td>
    </tr>
  `).join('');

  renderStats(registrations);
}

async function loadAdminDashboard() {
  const registrations = await fetchRegistrations();
  renderTable(registrations);
}

async function handleAdminLogin(event) {
  event.preventDefault();

  const username = document.getElementById('adminUsername').value.trim();
  const password = document.getElementById('adminPassword').value.trim();

  const response = await fetch('/api/admin/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username, password })
  });

  const result = await response.json();

  if (result.success) {
    setMessage(loginMessage, '', '');
    if (adminLoginSection) adminLoginSection.classList.add('hidden');
    if (adminDashboard) adminDashboard.classList.remove('hidden');
    await loadAdminDashboard();
  } else {
    setMessage(loginMessage, result.message || 'Login failed.', 'error');
  }
}

async function handleAdminLogout() {
  await fetch('/api/admin/logout', { method: 'POST' });
  if (adminLoginSection) adminLoginSection.classList.remove('hidden');
  if (adminDashboard) adminDashboard.classList.add('hidden');
}

async function approveRegistration(registrationId) {
  const response = await fetch(`/api/admin/registrations/${registrationId}/approve`, {
    method: 'POST'
  });

  const result = await response.json();
  if (result.success) {
    await loadAdminDashboard();
  }
}

async function deleteRegistration(registrationId) {
  const response = await fetch(`/api/admin/registrations/${registrationId}/delete`, {
    method: 'POST'
  });

  const result = await response.json();
  if (result.success) {
    await loadAdminDashboard();
  }
}

async function initiatePayment(registrationId) {
  const response = await fetch('/api/create-checkout-session', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ registrationId })
  });

  const result = await response.json();

  if (result.success && result.url) {
    window.location.href = result.url;
    return;
  }

  alert(result.message || 'Could not start payment.');
}

if (loginForm) {
  loginForm.addEventListener('submit', handleAdminLogin);
}

if (refreshBtn) {
  refreshBtn.addEventListener('click', loadAdminDashboard);
}

if (logoutBtn) {
  logoutBtn.addEventListener('click', handleAdminLogout);
}

document.addEventListener('click', async (event) => {
  const button = event.target.closest('[data-action]');
  if (!button) return;

  const action = button.dataset.action;
  const registrationId = button.dataset.id;

  if (action === 'approve') {
    await approveRegistration(registrationId);
  }

  if (action === 'delete') {
    await deleteRegistration(registrationId);
  }

  if (action === 'pay') {
    await initiatePayment(registrationId);
  }
});

(async function bootstrapAdmin() {
  if (adminDashboard && !adminDashboard.classList.contains('hidden')) {
    await loadAdminDashboard();
  }
})();
